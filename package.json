{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"description": "Public portfolio monorepo (apps/test-manager, apps/workbook-app)",
	"packageManager": "pnpm@10.18.3",
	"scripts": {
		"lint": "pnpm run lint:biome && pnpm run lint:eslint",
		"lint:biome": "biome lint .",
		"lint:eslint": "eslint . --ext .ts,.tsx",
		"dev": "pnpm -C apps/workbook-app dev",
		"dev:local": "pnpm -C apps/workbook-app dev:local",
		"workbook-convert": "node ./scripts/workbook-convert/index.cjs",
		"test:workbook-convert": "node --test ./scripts/workbook-convert/convert.test.cjs"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
