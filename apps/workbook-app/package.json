{
  "name": "demo-workbook-app",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "client:start": "corepack pnpm --dir client start",
    "client:test": "corepack pnpm --dir client test",
    "backend:emulators": "corepack pnpm --dir backend emulators:start",
    "functions:install": "corepack pnpm --dir backend/functions install --ignore-workspace",
    "dev:local": "node ./scripts/devLocal.cjs",
    "emulators": "corepack pnpm --dir backend emulators:start",
    "dev": "node ./scripts/devLocal.cjs --device"
  }
}
