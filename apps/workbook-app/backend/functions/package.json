{
	"name": "functions",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"serve": "corepack pnpm run build && firebase emulators:start --only functions --import data --export-on-exit",
		"shell": "corepack pnpm run build && firebase functions:shell",
		"start": "corepack pnpm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log"
	},
	"engines": {
		"node": "22",
		"pnpm": "10.34.5"
	},
	"main": "lib/index.js",
	"dependencies": {
		"@google-cloud/storage": "^7.22.0",
		"@googleapis/docs": "^14.0.0",
		"archiver": "^7.0.1",
		"bowser": "^2.14.1",
		"cors": "^2.8.6",
		"firebase-admin": "^13.10.0",
		"firebase-functions": "^7.4.0",
		"googleapis": "^181.0.0",
		"ulid": "^2.4.0"
	},
	"devDependencies": {
		"@types/archiver": "^6.0.4",
		"@types/node": "^22.20.3",
		"firebase-functions-test": "^3.5.0",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@firebase/util",
			"protobufjs",
			"unrs-resolver"
		]
	},
	"private": true
}
