{
  "name": "workbook-client",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    ".storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "doctor": "node scripts/run-expo-doctor.mjs",
    "new": "hygen component new ",
    "test": "jest",
    "typecheck:storybook": "tsc --noEmit --pretty false --project tsconfig.storybook.json",
    "expo:dev": "cross-env APP_ENV=development EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "expo:dev:local": "node scripts/start-local-adb.mjs student",
    "expo:devnoc": "cross-env APP_ENV=development IS_CONS=false EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "expo:prod": "cross-env APP_ENV=production expo start --dev-client",
    "dev:local": "cross-env APP_ENV=local EXPO_UNSTABLE_MCP_SERVER=1 EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2 EXPO_PUBLIC_MOCK_ACCOUNT=student expo start --dev-client",
    "dev:local:teacher": "cross-env APP_ENV=local EXPO_UNSTABLE_MCP_SERVER=1 EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2 EXPO_PUBLIC_MOCK_ACCOUNT=teacher expo start --dev-client",
    "dev:local:admin": "cross-env APP_ENV=local EXPO_UNSTABLE_MCP_SERVER=1 EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2 EXPO_PUBLIC_MOCK_ACCOUNT=admin expo start --dev-client",
    "dev:local:ios": "cross-env APP_ENV=local EXPO_UNSTABLE_MCP_SERVER=1 EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost EXPO_PUBLIC_MOCK_ACCOUNT=student expo start --dev-client",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:prod": "eas build --platform android --profile production",
    "build:android:stag": "eas build --platform android --profile staging",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:ios:stag": "eas build --platform ios --profile staging",
    "dev:local:adb": "node scripts/start-local-adb.mjs student",
    "dev:local:adb:teacher": "node scripts/start-local-adb.mjs teacher",
    "dev:local:adb:admin": "node scripts/start-local-adb.mjs admin",
    "test:timezones": "node scripts/test-timezones.mjs",
    "build:dev:local": "cross-env APP_ENV=local EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2 EXPO_PUBLIC_MOCK_ACCOUNT=student expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@dr.pogodin/react-native-fs": "^2.40.3",
    "@react-native-firebase/analytics": "25.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/database": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-firebase/functions": "25.1.0",
    "@react-native-firebase/storage": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/material-top-tabs": "^7.7.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@react-navigation/stack": "^7.11.1",
    "@shopify/flash-list": "2.0.2",
    "@supercharge/promise-pool": "^3.3.0",
    "babel-plugin-dotenv-import": "^3.0.1",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "expo": "^57.0.24",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
