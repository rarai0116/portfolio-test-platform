    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "fs-extra": "^11.4.0",
    "jest-node-exports-resolver": "^1.1.6",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-animatable": "1.4.0",
    "react-native-edge-to-edge": "1.7.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-skeleton": "1.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-storage": "^0.2.4",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "9.5.1",
    "seedrandom": "^3.0.5",
    "tailwindcss": "^4.3.3",
    "twrnc": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@biomejs/biome": "2.5.14",
    "@chromatic-com/storybook": "5.3.1",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/dom-webview": "~57.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@react-native/jest-preset": "^0.86.3",
    "@react-navigation/elements": "^2.9.42",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-react-native-web": "0.0.29",
    "@storybook/react": "10.6.0",
    "@storybook/react-webpack5": "10.6.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-native-web": "^0.21.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.12",
    "cross-env": "^10.1.0",
    "eas-cli": "24.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "^1.20.4",
    "expo-mcp": "~0.2.1",
    "hygen": "^6.2.11",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "jest-expo": "~57.0.5",
    "postcss": "8.5.28",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.2.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web-webview": "^1.0.2",
    "react-test-renderer": "19.2.3",
    "storybook": "10.6.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "react-native-zip-archive",
          "react-native-modal",
          "react-native-fs"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true,
  "engines": {
    "node": "22.23.2"
  }
}
