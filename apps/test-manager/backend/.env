# ⚠️ このファイルは公開リポジトリに commit されます（レビュー者がそのまま起動できるようにするため）。
#    実鍵・実 credential は絶対に書かないこと。値はすべてデモ用ダミーです。
#    実運用の値は .env.local / .env.prod（gitignore 対象）へ。
IS_LOCAL=true
# release/sync スクリプト用のダミー鍵（build/emulator では未使用）。
# 32バイトの base64（44文字）。base64 デコードすると "DUMMY-NOT-A-REAL-KEY-…" と読める合成値。
K_ENC_B64=RFVNTVktTk9ULUEtUkVBTC1LRVktRU5DLURFTU8hISE=
K_SIG_B64=RFVNTVktTk9ULUEtUkVBTC1LRVktU0lHLURFTU8hISE=
