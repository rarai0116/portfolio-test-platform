{
  "name": "backend",
  "version": "0.1.0",
  "description": "Firebase project for the demo-test-manager",
  "scripts": {
    "build": "tsc",
    "build:functions": "pnpm --prefix ./functions run build",
    "cache-index:build": "node ./scripts/buildCacheIndex.cjs",
    "cache-index:update-entries": "node ./scripts/updateCacheIndexEntries.cjs",
    "images:audit-storage-list": "node ./scripts/auditStorageListObjects.cjs",
    "images:upload-missing": "node ./scripts/uploadMissingImages.cjs",
    "images:sync-usage": "node ./scripts/syncImageUsageMetadata.cjs",
    "images:delete-unused": "node ./scripts/deleteUnusedImages.cjs",
    "testdata:normalize-status": "node ./scripts/normalizeTestDataStatus.cjs",
    "testdata:compact-formulas": "node ./scripts/compactTestDataFormulaHtml.cjs",
    "testdata:sanitize-html": "node ./scripts/sanitizeTestDataHtml.cjs",
    "testdata:normalize-legacy-indent": "node ./scripts/normalizeLegacyTestDataIndent.cjs",
    "testdata:delete-by-id": "node ./scripts/deleteTestDataById.cjs",
    "test:manual:formula-rendering": "node ./scripts/runManualFormulaRenderingTest.cjs",
    "test:manual:preview-sanitize-audit": "node ./scripts/runManualPreviewSanitizeAudit.cjs",
    "testdata:import": "node ./scripts/importTestData.cjs",
    "emulators:start": "node ./scripts/emulatorsStart.cjs",
    "emulators:start:no-import": "node ./scripts/emulatorsStart.cjs --no-import",
    "emulators:start:persist": "node ./scripts/emulatorsStart.cjs --persist",
    "emulators:start-no-import": "pnpm run build:functions && firebase emulators:start",
    "test:client:emulator": "pnpm run build:functions && firebase emulators:exec --project demo-test-manager --only auth,functions,firestore,storage \"pnpm --prefix ../client run test:unit\"",
    "deploy": "firebase deploy",
    "lint:biome": "biome check ",
    "lint:eslint": "eslint . --ext .ts",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "test": "vitest run --coverage",
    "typecheck": "pnpm run --filter=functions build --noEmit",
    "pr-checks": "pnpm run lint:biome && pnpm run lint:eslint && pnpm run typecheck && pnpm run test",
    "sync:prod": "node ./scripts/syncProdDataWrapper.cjs",
    "sync:prod:force": "node ./scripts/syncProdDataWrapper.cjs --force-export-clean",
    "storage:fix-metadata": "node ./scripts/fixStorageMetadata.cjs",
    "update-config:set": "node ./scripts/syncEncryptData.cjs",
    "release:update": "node ./scripts/releaseUpdate.cjs --project demo-test-manager",
    "release:update:local": "cross-env DOTENV_CONFIG_PATH=.env.local node ./scripts/releaseUpdate.cjs --project demo-test-manager",
    "test:qaa": "node ./scripts/runQaaVitest.cjs",
    "projects:backup": "node ./scripts/backupGitHubProjectV2.cjs",
    "projects:import:pdf-tasks": "node ./scripts/importPdfTasksToGitHubProject.cjs",
    "testdata:create-empty": "node ./scripts/createEmptyTestData.cjs",
    "users:seed-teacher": "node ./scripts/seedTeacherUser.cjs",
    "emulators:start:persist:fresh": "node ./scripts/emulatorsStart.cjs --persist --no-import"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.4.0",
    "jsdom": "^26.1.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
