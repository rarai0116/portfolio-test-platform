{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest --watch",
    "migrate:grades:build": "tsc -p tsconfig.json",
    "migrate:grades": "npm run migrate:grades:build && node lib/scripts/migrateGrade.js",
    "migrate:grades:dry": "cross-env DRY_RUN=1 npm run migrate:grades"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.18.0",
    "@types/node": "^22.19.7",
    "cross-env": "^10.1.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "private": true
}
