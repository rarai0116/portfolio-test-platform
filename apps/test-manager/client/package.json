{
  "name": "client",
  "version": "2.3.1",
  "description": "建築士試験用問題データの管理・編集・発行ツール",
  "main": "./out/main/index.js",
  "author": "Studio Corobo",
  "homepage": "https://electron-vite.org",
  "lint": "biomejs",
  "type": "module",
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint . --ext .ts,.tsx",
    "format": "biome format",
    "typecheck:node": "pnpm tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "pnpm tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:unit": "vitest run --coverage",
    "test:manual:formula-rendering": "vitest run --config vitest.manual.config.ts src/test/manual/testDataFormulaRendering.manual.test.tsx",
    "test:manual:formula-rendering:preview": "cross-env MANUAL_FORMULA_STAGE=preview vitest run --config vitest.manual.config.ts src/test/manual/testDataFormulaRendering.manual.test.tsx",
    "test:manual:formula-rendering:quill": "cross-env MANUAL_FORMULA_STAGE=quill vitest run --config vitest.manual.config.ts src/test/manual/testDataFormulaRendering.manual.test.tsx",
    "test:manual:preview-sanitize-audit": "vitest run --config vitest.manual.config.ts src/test/manual/testDataPreviewSanitizeAudit.manual.test.tsx",
    "verify:pdf-page-margin": "electron ./scripts/verifyPdfPageMargin.cjs",
    "verify:asset-protocol-cache": "electron ./scripts/verifyAssetProtocolCache.cjs",
    "verify:asset-db-migration": "electron ./scripts/verifyAssetDbMigration.cjs",
    "test": "pnpm run test:unit",
    "dev": "pnpm electron-vite dev -- --no-sandbox --watch",
    "dev:prod": "cross-env DOTENV_CONFIG_PATH=.env.prod pnpm electron-vite dev --mode prod -- --no-sandbox --watch",
    "dev:debug-preview": "pnpm electron-vite dev -- --no-sandbox --watch --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1",
    "dev:prod:debug-preview": "cross-env DOTENV_CONFIG_PATH=.env.prod pnpm electron-vite dev --mode prod -- --no-sandbox --watch --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1",
    "build": "pnpm run typecheck && pnpm electron-vite build --mode prod",
    "measure:build": "pnpm run build",
    "measure:prepare": "node ./scripts/prepareMemoryMeasurement.cjs",
    "measure:start": "node ./scripts/runMemoryMeasurement.cjs",
    "postinstall": "pnpm electron-builder install-app-deps",
    "build:unpack": "pnpm run build && pnpm electron-builder --dir",
    "build:win": "pnpm run build && pnpm electron-builder --win",
    "build:mac": "pnpm electron-vite build && pnpm electron-builder --mac",
    "build:linux": "pnpm electron-vite build && pnpm electron-builder --linux",
    "pr-checks": "pnpm run lint:biome && pnpm run lint:eslint && pnpm run typecheck && pnpm run test:unit",
    "build:dev": "pnpm run typecheck && pnpm electron-vite build --mode development"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/katex": "^0.16.8",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^4.13.1",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "firebase": "^12.11.0",
    "fs-extra": "^11.3.4",
    "got": "^14.6.6",
    "katex": "^0.16.44",
    "lucide-react": "^0.525.0",
    "quill": "2.0.2",
    "quill-resize-module": "^2.1.3",
    "react-data-grid": "7.0.0-beta.58",
    "react-dropzone": "^14.4.1",
    "react-resizable-panels": "^4.8.0",
    "react-router": "^7.13.2",
    "react-select": "^5.10.2",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-reload": "2.0.0-alpha.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
