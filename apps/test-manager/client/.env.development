# ⚠️ このファイルは公開リポジトリに commit されます（レビュー者がそのまま起動できるようにするため）。
#    実鍵・実 credential は絶対に書かないこと。値はすべてデモ用ダミーです。
#    実運用の値は .env.local / .env.prod（gitignore 対象）へ。
VITE_USE_FIREBASE_EMULATOR=true
# emulator ログイン用のモック credential
# - t- 接頭辞: サニタイズ後の functions が startsWith('t-') で claim を付与する
# - @demoschool.ac.jp: サニタイズ後の firestore.rules が許可するドメイン（他に demoschool.jp）
LOCAL_AUTH_EMAIL=t-dev-local@demoschool.ac.jp
LOCAL_AUTH_SUBJECT=demo-dev-local
