prefix_rule(
    pattern = ["pnpm", "install"],
    decision = "prompt",
    justification = "Package installation requires explicit user confirmation in this repository.",
    match = [
        "pnpm install",
        "pnpm install --frozen-lockfile",
    ],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Package installation requires explicit user confirmation in this repository.",
    match = [
        "npm install",
        "npm install eslint",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive git cleanup is blocked. Use non-destructive alternatives and ask the user first.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Discarding tracked file changes is blocked. Use non-destructive alternatives and ask the user first.",
    match = [
        "git checkout -- README.md",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive deletion is blocked by repository policy.",
    match = [
        "rm -rf dist",
    ],
)